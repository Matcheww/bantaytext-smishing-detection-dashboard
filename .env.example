# Point the Next.js app at the running inference service (see inference-service/README.md).
# Copy this file to .env.local and adjust as needed.
INFERENCE_API_URL=http://localhost:8000

# Optional: shared secret sent on every request to the inference service.
# Must match INFERENCE_SERVICE_SECRET set on the inference-service side.
# Leave both unset for local dev; set both before deploying anywhere the
# inference service might be reachable beyond localhost.
# INFERENCE_SERVICE_SECRET=change-me-to-a-random-value

# Fallback in-memory rate limit for /api/predict, used automatically outside
# production and on any deployment where the Vercel Firewall rule below
# isn't configured (defaults: 10 requests / 60s per IP).
# PREDICT_RATE_LIMIT=10
# PREDICT_RATE_LIMIT_WINDOW_MS=60000

# --- Deploying to Vercel? ---
# The in-memory limiter above does NOT work reliably across Vercel's
# serverless function instances. For real protection in production, add a
# Rate Limiting rule in the Vercel dashboard:
#   Project -> Firewall tab -> Rate Limiting -> New rule
#   Condition: matches requests to /api/predict
#   ID: predict-api   (must match VERCEL_RATE_LIMIT_ID in app/api/predict/route.ts)
#   Limit: e.g. 10 requests per 60s per IP
# Once that rule exists, /api/predict automatically uses it instead of the
# in-memory fallback — no code changes needed, the route already checks for
# it first. See @vercel/firewall docs: https://vercel.com/docs/vercel-firewall/vercel-waf/rate-limiting-sdk
