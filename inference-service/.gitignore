.venv/
__pycache__/
*.pyc

# env files — contains INFERENCE_SERVICE_SECRET and other secrets, must
# never be committed. Copy .env.example to .env locally instead.
.env
.env.*
!.env.example

# Large trained model artifacts should not be committed to git.
# Copy them here locally, or mount them in your deployment environment.
artifacts/*
!artifacts/.gitkeep