# Copy this file to .env in the inference-service/ directory and adjust as needed.
# Loaded automatically on startup (app/config.py calls load_dotenv()) —
# no need to pass --env-file manually.

# Optional: must match INFERENCE_SERVICE_SECRET in the Next.js app's
# .env.local. Leave unset for local dev (the secret check is skipped
# entirely when this is unset on this side).
# INFERENCE_SERVICE_SECRET=change-me-to-a-random-value

# Optional: comma-separated list of allowed frontend origins for CORS.
# Defaults to http://localhost:3000,http://127.0.0.1:3000 if unset.
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: override artifact locations instead of using inference-service/artifacts/.
# BANTAYTEXT_ARTIFACTS_DIR=/path/to/artifacts
# TEACHER_MODEL_DIR=/path/to/fine_tuned_teacher_model
# DISTILLED_STUDENT_CHECKPOINT=/path/to/best_distilled_student_model.pth
# RAW_STUDENT_CHECKPOINT=/path/to/best_raw_student_model.pth
# TRADITIONAL_MODEL_PATH=/path/to/traditional_spam_classifier.joblib